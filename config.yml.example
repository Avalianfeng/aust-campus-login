# 安徽理工大学(AUST)校园网登录配置
# 复制为 config.yml 并填入账号（config.yml 勿提交 Git）

# 学号（脚本会自动拼接运营商后缀）
username: "你的学号"
password: "你的密码"

# 运营商后缀映射（安理工专用，勿与其他学校混用）：
#   unicom  -> 学号@unicom  联通
#   telecom -> 学号@aust    电信（注意不是 @telecom）
#   mobile  -> 学号@cmcc    移动
#   jzg     -> 学号@jzg     教职工
isp: "telecom"

# Dr.COM 登录参数（一般无需修改）
mk_key: "123456"

# 请求超时（秒）
timeout: 5
verify_delay: 2

# 守护模式检测间隔（秒），--watch 时使用
watch_interval: 300

# 登录成功后可选执行的命令（例如重启 cloudflared）
# post_login_cmd: "pm2 restart cloudflared"
